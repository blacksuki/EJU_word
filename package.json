{
  "name": "eju-wordtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/content/check-development.mjs",
    "content:audio": "node --experimental-strip-types scripts/content/generate-pilot.ts",
    "content:audio:50": "node --experimental-strip-types scripts/content/generate-pilot.ts --pilot-size 50",
    "content:export": "node --experimental-strip-types scripts/content/export-reviewed.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.4",
    "@types/node": "^22.0.0"
  }
}
